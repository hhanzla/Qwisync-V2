---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import AIPoweredWorkflow from '../components/AIPoweredWorkflow.astro';
import WhatDrivesUs from '../components/WhatDrivesUs.astro';
import AboutHowWeWork from '../components/AboutHowWeWork.astro';
---

<Layout title="About Us | Qwisync">
  {/* Dark red background glow (Fixed at top) */}
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-0 left-1/2 w-[600px] h-[600px] bg-accent-red/15 rounded-full blur-[120px] -translate-x-1/2 -translate-y-1/2"
    >
    </div>
  </div>

  {/* Hero Section */}
  <section class="relative w-full overflow-hidden pt-32 pb-8 md:pb-12">
    
    {/* Background Vertical Lines */}
    <div class="absolute inset-0 z-0 flex justify-between w-[95vw] md:w-[90vw] max-w-[1920px] mx-auto pointer-events-none overflow-hidden opacity-40">
      {[1.2, 3.5, 0.8, 4.1, 2.5].map((delay) => (
        <div class="relative w-[1px] h-full bg-white/5">
          <div
            class="absolute left-[-1px] w-[3px] h-[30vh] bg-gradient-to-b from-transparent via-accent-red to-transparent blur-[2px] light-strip"
            style={`animation-delay: ${delay}s;`}
          />
        </div>
      ))}
    </div>

    <div class="relative z-10 w-full min-h-[50vh] md:min-h-[60vh] flex flex-col justify-center items-center text-center px-4 mt-0 md:-mt-4">
      
      {/* About Badge */}
      <div class="hero-reveal overflow-hidden mb-6 md:mb-8">
        <div class="translate-y-full inline-block">
          <div class="border border-accent-red/20 bg-accent-red/10 backdrop-blur-md px-4 py-1.5 flex items-center justify-center">
            <h3 class="hover-scramble text-accent-red font-space-mono text-[9px] md:text-[10px] font-bold tracking-[0.25em] uppercase leading-none mt-[2px] cursor-default" data-text="ABOUT QWISYNC">
              <span class="scramble-text pointer-events-none">ABOUT QWISYNC</span>
            </h3>
          </div>
        </div>
      </div>

      {/* Hero Headings */}
      <div class="flex flex-col items-center justify-center mb-1">
        <div class="hero-reveal overflow-hidden leading-[0.85] mb-1">
          <h1 class="text-[10vw] md:text-[75px] lg:text-[90px] tracking-[-0.02em] font-jetbrains-mono font-bold text-[#EFEBE3] translate-y-[120%] inline-block uppercase whitespace-nowrap">
            WE BUILD
          </h1>
        </div>
        <div class="hero-reveal overflow-hidden leading-[0.85] mb-1">
          <h1 class="text-[10vw] md:text-[75px] lg:text-[90px] tracking-[-0.02em] font-jetbrains-mono font-bold text-[#EFEBE3] translate-y-[120%] inline-block uppercase whitespace-nowrap">
            DIGITAL
          </h1>
        </div>
        <div class="hero-reveal overflow-hidden leading-[0.85] mb-1">
          <h1 class="text-[10vw] md:text-[75px] lg:text-[90px] tracking-[-0.02em] font-jetbrains-mono font-bold text-accent-red translate-y-[120%] inline-block uppercase whitespace-nowrap">
            FUTURES
          </h1>
        </div>
      </div>

      {/* Description */}
      <div class="hero-reveal overflow-hidden mt-6 mb-4 max-w-xl mx-auto">
        <p class="font-space-mono text-qwi-text-body text-[12px] md:text-[14px] leading-[1.8] translate-y-full inline-block">
          A Pak, US-based digital agency combining strategy, design, SEO, and development for businesses across Pak, US.
        </p>
      </div>
    </div>
  </section>

  {/* Our Story Section */}
  <section class="w-full relative z-20 pt-8 md:pt-12 pb-24 md:pb-32 bg-[#0a0a0a]" id="our-story">
    <div class="w-[90%] max-w-[1200px] mx-auto flex flex-col md:flex-row md:items-start justify-between gap-12 md:gap-20">
      
      {/* Left side: Heading */}
      <div class="md:w-1/3 flex flex-col pt-2">
        <div class="hero-reveal overflow-hidden leading-[0.85] mb-1">
          <h2 class="text-[12vw] md:text-[80px] lg:text-[90px] tracking-[-0.02em] font-jetbrains-mono font-bold text-qwi-text-heading translate-y-[120%] inline-block uppercase">
            OUR
          </h2>
        </div>
        <div class="story-reveal overflow-hidden leading-[0.85]">
          <h2 class="text-transparent [-webkit-text-stroke:1px_var(--color-qwi-text-heading)] text-[12vw] md:text-[80px] lg:text-[90px] tracking-[-0.02em] font-jetbrains-mono font-bold translate-y-[120%] inline-block uppercase">
            STORY
          </h2>
        </div>
      </div>

      {/* Right side: Text */}
      <div class="md:w-2/3 flex flex-col space-y-6">
        <div class="story-text-reveal overflow-hidden">
          <p class="font-space-mono text-qwi-text-desc text-[13px] md:text-[14px] leading-[1.9] translate-y-full opacity-0">
            Qwisync was founded with a simple belief: businesses deserve digital products that look world-class and actually work. Not templates. Not shortcuts. Real products built with real strategy.
          </p>
        </div>
        
        <div class="story-text-reveal overflow-hidden">
          <p class="font-space-mono text-qwi-text-desc text-[13px] md:text-[14px] leading-[1.9] translate-y-full opacity-0">
            We started as a small team of designers and developers in Pak, US. Today, we're a full-service digital agency with expertise spanning web development, mobile apps, AI integration, blockchain, and brand identity.
          </p>
        </div>
        
        <div class="story-text-reveal overflow-hidden">
          <p class="font-space-mono text-qwi-text-desc text-[13px] md:text-[14px] leading-[1.9] translate-y-full opacity-0">
            What makes us different? <span class="text-accent-red font-bold">We're AI-powered.</span> We use artificial intelligence across our entire workflow &mdash; from research and design to development and testing &mdash; so we deliver faster, smarter, and at a quality level that punches well above our size.
          </p>
        </div>
      </div>

    </div>
  </section>

  <AIPoweredWorkflow />

  <WhatDrivesUs />

  <AboutHowWeWork />

  <Footer />
</Layout>

<style>
  /* Vertical Light Strips */
  .light-strip {
    animation: strip-light 6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    top: -40vh;
  }
  @keyframes strip-light {
    0% {
      top: -40vh;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: 120vh;
      opacity: 0;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Hero Text Reveal Sequence
  const heroReveals = document.querySelectorAll(".hero-reveal > *");
  if (heroReveals.length > 0) {
    gsap.to(heroReveals, {
      y: 0,
      duration: 1.2,
      stagger: 0.15,
      ease: "power4.out",
      delay: 0.5,
    });
  }

  // Our Story Title Reveal
  const storyReveals = document.querySelectorAll("#our-story .story-reveal > *");
  if (storyReveals.length > 0) {
    gsap.to(storyReveals, {
      scrollTrigger: {
        trigger: "#our-story",
        start: "top 80%",
      },
      y: 0,
      duration: 1.2,
      stagger: 0.15,
      ease: "power4.out"
    });
  }

  // Our Story Text Reveal
  const storyTexts = document.querySelectorAll("#our-story .story-text-reveal > p");
  if (storyTexts.length > 0) {
    gsap.to(storyTexts, {
      scrollTrigger: {
        trigger: "#our-story",
        start: "top 75%",
      },
      y: 0,
      opacity: 1,
      duration: 1.0,
      stagger: 0.2,
      ease: "power3.out"
    });
  }
</script>
