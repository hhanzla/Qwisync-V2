---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const projects = [
  {
    num: "01",
    title: "MWT - SOLAR ENGINEERING",
    year: "2025",
    image: "https://k3studios.ae/wp-content/uploads/2026/05/Solar-power-systems-built-for-real-operating-conditions-MWT-Group-05-09-2026_09_35_PM-1024x587.png"
  },
  {
    num: "02",
    title: "Domo Mark",
    year: "2025",
    image: "https://k3studios.ae/wp-content/uploads/2026/05/image-75-1024x691.png"
  },
  {
    num: "03",
    title: "TARS Protocol",
    year: "2025",
    image: "https://k3studios.ae/wp-content/uploads/2026/03/home-section1-1024x586.png"
  },
  {
    num: "04",
    title: "Tars Sona",
    year: "2025",
    image: "https://k3studios.ae/wp-content/uploads/2026/03/Sona-03-18-2026_05_15_PM-1024x517.png"
  }
];
---

<Layout title="Selected Work | Qwisync">
  {/* Dark red background glow (Fixed at top) */}
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-0 left-1/2 w-[600px] h-[600px] bg-accent-red/15 rounded-full blur-[120px] -translate-x-1/2 -translate-y-1/2"
    >
    </div>
  </div>

  {/* Hero & Filter Section Combined */}
  <section class="relative w-full overflow-hidden pt-32">
    
    {/* Background Vertical Lines */}
    <div class="absolute inset-0 z-0 flex justify-between w-[95vw] md:w-[90vw] max-w-[1920px] mx-auto pointer-events-none overflow-hidden opacity-40">
      {[1.2, 3.5, 0.8, 4.1, 2.5].map((delay) => (
        <div class="relative w-[1px] h-full bg-white/5">
          <div
            class="absolute left-[-1px] w-[3px] h-[30vh] bg-gradient-to-b from-transparent via-accent-red to-transparent blur-[2px] light-strip"
            style={`animation-delay: ${delay}s;`}
          />
        </div>
      ))}
    </div>

    <div class="relative z-10 w-full min-h-[50vh] md:min-h-[60vh] flex flex-col justify-center items-center text-center px-4 mt-0 md:-mt-4 pb-16 md:pb-24">
      {/* Portfolio Badge */}
      <div class="hero-reveal overflow-hidden mb-6 md:mb-8">
        <div class="translate-y-full inline-block">
          <div class="border border-accent-red/20 bg-accent-red/10 backdrop-blur-md px-4 py-1.5 flex items-center justify-center">
            <h3 class="hover-scramble text-accent-red font-space-mono text-[9px] md:text-[10px] font-bold tracking-[0.25em] uppercase leading-none mt-[2px] cursor-default" data-text="OUR PORTFOLIO">
              <span class="scramble-text pointer-events-none">OUR PORTFOLIO</span>
            </h3>
          </div>
        </div>
      </div>

      {/* Hero Headings */}
      <div class="flex flex-col items-center justify-center mb-1">
        <div class="hero-reveal overflow-hidden leading-[0.8] mb-1">
          <h1 class="text-[10vw] md:text-[75px] lg:text-[90px] tracking-[-0.05em] font-jetbrains-mono font-bold text-[#EFEBE3] translate-y-[120%] inline-block uppercase whitespace-nowrap">
            SELECTED
          </h1>
        </div>
        <div class="hero-reveal overflow-hidden leading-[0.8] mb-1">
          <h1 class="text-[10vw] md:text-[75px] lg:text-[90px] tracking-[-0.05em] font-jetbrains-mono font-bold text-accent-red translate-y-[120%] inline-block uppercase whitespace-nowrap">
            WORK
          </h1>
        </div>
      </div>

      {/* Description */}
      <div class="hero-reveal overflow-hidden mt-6 mb-4 max-w-xl mx-auto">
        <p class="font-space-mono text-qwi-text-body text-[12px] md:text-[14px] leading-[1.8] translate-y-full inline-block">
          Websites, brands, apps, and platforms built for real Pak, US business goals.
        </p>
      </div>
    </div>

    {/* Filter Tabs Section */}
    <div class="w-full relative z-20 border-b border-white/5">
    <div class="w-[90%] max-w-[1200px] mx-auto flex items-center space-x-8 md:space-x-12 overflow-x-auto no-scrollbar">
      
      {/* ALL (Active) */}
      <button class="relative pb-4 group focus:outline-none shrink-0 cursor-pointer">
        <span class="text-accent-red font-space-mono text-[11px] md:text-[13px] font-bold tracking-widest uppercase">
          ALL
        </span>
        <div class="absolute bottom-[-1px] left-0 w-full h-[2px] bg-accent-red"></div>
      </button>

      {/* WEB DESIGN (Inactive) */}
      <button class="relative pb-4 group focus:outline-none shrink-0 cursor-pointer">
        <span class="text-qwi-text-desc group-hover:text-qwi-text-heading transition-colors duration-300 font-space-mono text-[11px] md:text-[13px] font-bold tracking-widest uppercase">
          WEB DESIGN
        </span>
        <div class="absolute bottom-[-1px] left-0 w-full h-[2px] bg-transparent group-hover:bg-white/10 transition-colors duration-300"></div>
      </button>
      
    </div>
  </div>
  </section>

  {/* Projects Grid Section */}
  <section class="w-full relative z-20 pb-24 md:pb-32 bg-[#0a0a0a]">
    <div class="w-[90%] max-w-[1200px] mx-auto mt-12 md:mt-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 md:gap-x-12 gap-y-16 md:gap-y-24">
        {projects.map((project, index) => (
          <a href={`/work#${project.title.toLowerCase().replace(/\s+/g, '-')}`} class={`project-card group block cursor-pointer opacity-0 translate-y-12 ${index < 2 ? 'first-item-anim' : 'animate-on-scroll'}`}>
            <div class="relative w-full aspect-[16/10] overflow-hidden mb-6 bg-white/5 border border-white/10">
              <img 
                src={project.image} 
                alt={project.title} 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] opacity-90 group-hover:opacity-100" 
                loading="lazy" 
              />
            </div>
            <div class="flex items-start">
              <span class="text-accent-red font-jetbrains-mono font-bold text-[10px] md:text-[11px] mr-5 md:mr-6 pt-[3px] md:pt-[5px]">{project.num}</span>
              <div class="flex flex-col">
                <h3 class="hover-scramble text-qwi-text-heading font-jetbrains-mono font-bold text-[17px] md:text-[22px] tracking-wide mb-1 uppercase" data-text={project.title}>
                  <span class="scramble-text pointer-events-none">{project.title}</span>
                </h3>
                <span class="text-qwi-text-desc font-space-mono text-[11px] md:text-[12px]">{project.year}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Vertical Light Strips */
  .light-strip {
    animation: strip-light 6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    top: -40vh;
  }
  @keyframes strip-light {
    0% {
      top: -40vh;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: 120vh;
      opacity: 0;
    }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Text Reveal Sequence
  const reveals = document.querySelectorAll(".hero-reveal > *");
  if (reveals.length > 0) {
    gsap.to(reveals, {
      y: 0,
      duration: 1.2,
      stagger: 0.15,
      ease: "power4.out",
      delay: 0.5,
    });
  }

  // Fade Up Project Cards on Scroll
  const scrollCards = document.querySelectorAll('.project-card.animate-on-scroll');
  scrollCards.forEach((card, index) => {
    gsap.to(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 85%',
      },
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'power3.out'
    });
  });

  // Animate first 2 cards on load (sync with hero)
  const firstCards = document.querySelectorAll('.project-card.first-item-anim');
  if (firstCards.length > 0) {
    gsap.to(firstCards, {
      opacity: 1,
      y: 0,
      duration: 0.8,
      delay: 1.0,
      stagger: 0.15,
      ease: 'power3.out'
    });
  }
</script>
