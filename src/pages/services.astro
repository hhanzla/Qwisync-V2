---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import DigitalServices from '../components/DigitalServices.astro';
import WhyQwisync from '../components/WhyQwisync.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Industries from '../components/Industries.astro';
---

<Layout title="Our Services | Qwisync">
  {/* Dark red background glow (Fixed at top) */}
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-0 left-1/2 w-[600px] h-[600px] bg-accent-red/15 rounded-full blur-[120px] -translate-x-1/2 -translate-y-1/2"
    >
    </div>
  </div>

  {/* Hero Section */}
  <section class="relative w-full overflow-hidden pt-32">
    
    {/* Background Vertical Lines */}
    <div class="absolute inset-0 z-0 flex justify-between w-[95vw] md:w-[90vw] max-w-[1920px] mx-auto pointer-events-none overflow-hidden opacity-40">
      {[1.2, 3.5, 0.8, 4.1, 2.5].map((delay) => (
        <div class="relative w-[1px] h-full bg-white/5">
          <div
            class="absolute left-[-1px] w-[3px] h-[30vh] bg-gradient-to-b from-transparent via-accent-red to-transparent blur-[2px] light-strip"
            style={`animation-delay: ${delay}s;`}
          />
        </div>
      ))}
    </div>

    <div class="relative z-10 w-full min-h-[50vh] md:min-h-[60vh] flex flex-col justify-center items-center text-center px-4 mt-0 md:-mt-4 pb-16 md:pb-24">
      {/* Portfolio Badge */}
      <div class="hero-reveal overflow-hidden mb-6 md:mb-8">
        <div class="translate-y-full inline-block">
          <div class="border border-accent-red/20 bg-accent-red/10 backdrop-blur-md px-4 py-1.5 flex items-center justify-center">
            <h3 class="hover-scramble text-accent-red font-space-mono text-[9px] md:text-[10px] font-bold tracking-[0.25em] uppercase leading-none mt-[2px] cursor-default" data-text="WHAT WE DO">
              <span class="scramble-text pointer-events-none">WHAT WE DO</span>
            </h3>
          </div>
        </div>
      </div>

      {/* Hero Headings */}
      <div class="flex flex-col items-center justify-center mb-1">
        <div class="hero-reveal overflow-hidden leading-[0.8] mb-1">
          <h1 class="text-[10vw] md:text-[75px] lg:text-[90px] tracking-[-0.05em] font-jetbrains-mono font-bold text-[#EFEBE3] translate-y-[120%] inline-block uppercase whitespace-nowrap">
            OUR
          </h1>
        </div>
        <div class="hero-reveal overflow-hidden leading-[0.8] mb-1">
          <h1 class="text-[10vw] md:text-[75px] lg:text-[90px] tracking-[-0.05em] font-jetbrains-mono font-bold text-accent-red translate-y-[120%] inline-block uppercase whitespace-nowrap">
            SERVICES
          </h1>
        </div>
      </div>

      {/* Description */}
      <div class="hero-reveal overflow-hidden mt-6 mb-4 max-w-xl mx-auto">
        <p class="font-space-mono text-qwi-text-body text-[12px] md:text-[14px] leading-[1.8] translate-y-full inline-block">
          Web design, SEO, branding, marketing, and development<br/>for Pak, US businesses ready to grow online.
        </p>
      </div>
    </div>
  </section>

  <DigitalServices hideHeader={true} hideTopBorder={true} compactTopPadding={true} />

  <WhyQwisync />

  <HowWeWork />

  <Industries />

  <Footer />
</Layout>

<style>
  /* Vertical Light Strips */
  .light-strip {
    animation: strip-light 6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    top: -40vh;
  }
  @keyframes strip-light {
    0% {
      top: -40vh;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: 120vh;
      opacity: 0;
    }
  }
</style>

<script>
  import gsap from "gsap";

  // Text Reveal Sequence
  const reveals = document.querySelectorAll(".hero-reveal > *");
  if (reveals.length > 0) {
    gsap.to(reveals, {
      y: 0,
      duration: 1.2,
      stagger: 0.15,
      ease: "power4.out",
      delay: 0.5,
    });
  }
</script>
