---
interface Props {
  hideHeader?: boolean;
  hideTopBorder?: boolean;
  compactTopPadding?: boolean;
}
const { hideHeader = false, hideTopBorder = false, compactTopPadding = false } = Astro.props;

const services = [
  {
    num: "01",
    title: "BRAND IDENTITY DESIGN",
    desc: "Brand identity design in Pak, US for businesses that need strategy, logo...",
  },
  {
    num: "02",
    title: "LOGO DESIGN",
    desc: "Logo design in Pak, US for startups, SMEs, and growing brands that...",
  },
  {
    num: "03",
    title: "WEB DESIGN",
    desc: "Web design company in Pak, US creating fast, SEO-ready websites for businesses...",
  },
  {
    num: "04",
    title: "WEB DEVELOPMENT",
    desc: "Website development company in Pak, US building fast WordPress, Shopify, custom, and headless...",
  },
  {
    num: "05",
    title: "MOBILE APP DEVELOPMENT",
    desc: "Mobile app development in Pak, US for startups and businesses building iOS,...",
  },
  {
    num: "06",
    title: "UI/UX DESIGN",
    desc: "UI/UX design in Pak, US for websites, SaaS products, ecommerce stores, and mobile...",
  },
  {
    num: "07",
    title: "AI SOLUTIONS",
    desc: "AI solutions in Pak, US for businesses that need practical automation, chatbots,...",
  },
  {
    num: "08",
    title: "BLOCKCHAIN DEVELOPMENT",
    desc: "Blockchain and Web3 development in Pak, US for smart contracts, DeFi products, token...",
  }
];
---

<section class={`w-full bg-qwi-bg-main relative overflow-hidden ${compactTopPadding ? 'pt-8 md:pt-12 pb-24 md:pb-32' : 'py-24 md:py-32'} ${hideTopBorder ? '' : 'border-t border-white/10'}`} id="services">
  
  {/* Header Section */}
  {!hideHeader && (
    <div class="flex flex-col items-center justify-center text-center mb-12 md:mb-16">
      <div class="services-reveal overflow-hidden leading-[0.9] pb-2">
        <h2 class="text-qwi-text-heading font-jetbrains-mono font-bold text-[10vw] md:text-[80px] leading-[0.9] tracking-tighter uppercase relative z-10 translate-y-[120%] inline-block">
          OUR DIGITAL
        </h2>
      </div>
      <div class="services-reveal overflow-hidden leading-[0.9] pb-2">
        <h2 class="text-transparent [-webkit-text-stroke:1px_var(--color-qwi-text-heading)] font-jetbrains-mono font-bold text-[10vw] md:text-[80px] leading-[0.9] tracking-tighter uppercase relative z-10 translate-y-[120%] inline-block">
          SERVICES
        </h2>
      </div>
    </div>
  )}

  {/* Services List */}
  <div class="services-list-container max-w-5xl mx-auto px-4 md:px-6">
    <div class="flex flex-col w-full">
      {services.map((service, index) => (
        <a 
          href={`/services#${service.title.toLowerCase().replace(/\s+/g, '-')}`}
          class={`service-row group block border-b border-white/10 ${index === 0 ? 'border-t opacity-0 translate-y-8 first-item-anim' : 'opacity-0 translate-y-8 animate-on-scroll'} hover:bg-[#0d0d0d] transition-colors duration-300 relative px-4 md:px-6 -mx-4 md:-mx-6`}
        >
          <div class="flex flex-col md:flex-row md:items-center py-3 md:py-4 w-full transition-transform duration-300 origin-left group-hover:scale-[0.98]">
            {/* Number */}
            <div class="md:w-16 shrink-0 mb-2 md:mb-0">
              <span class="text-accent-red font-jetbrains-mono text-[10px] md:text-[11px] font-bold tracking-widest opacity-80">
                {service.num}
              </span>
            </div>
            
            {/* Title */}
            <div class="md:flex-1 shrink-0 md:w-[280px] mb-1 md:mb-0 pr-4">
              <h3 class="hover-scramble text-qwi-text-heading font-jetbrains-mono font-bold text-[13px] md:text-[15px] tracking-widest uppercase transition-colors duration-300 group-hover:text-qwi-text-heading" data-text={service.title}>
                <span class="scramble-text pointer-events-none">{service.title}</span>
              </h3>
            </div>
            
            {/* Description */}
            <div class="md:flex-[1.5]">
              <p class="text-qwi-text-desc font-space-mono text-[10px] md:text-[11px] leading-[1.6] md:max-w-md transition-colors duration-300 group-hover:text-gray-300">
                {service.desc}
              </p>
            </div>

            {/* Arrow */}
            <div class="hidden md:flex items-center justify-end w-12 opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 text-accent-red font-space-mono">
              →
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
  
</section>

<script>
  // @ts-nocheck
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Reveal Header Texts
  const titleReveals = document.querySelectorAll('#services .services-reveal > h2');
  gsap.to(titleReveals, {
    scrollTrigger: {
      trigger: '#services',
      start: 'top 80%',
    },
    y: 0,
    duration: 1.2,
    stagger: 0.15,
    ease: 'power4.out'
  });

  // Fade Up Service Rows Individually
  const rows = document.querySelectorAll('#services .animate-on-scroll');
  rows.forEach((row) => {
    gsap.to(row, {
      scrollTrigger: {
        trigger: row,
        start: 'top 90%',
      },
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'power3.out'
    });
  });

  // Animate first item on load (to sync with hero sections if near top)
  const firstItems = document.querySelectorAll('#services .first-item-anim');
  if (firstItems.length > 0) {
    gsap.to(firstItems, {
      opacity: 1,
      y: 0,
      duration: 0.8,
      delay: 1.0, // Matches hero animation completion
      ease: 'power3.out'
    });
  }
</script>
