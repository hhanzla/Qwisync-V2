---
interface Props {
  href: string;
  text: string;
  className?: string;
}

const { href, text, className = "" } = Astro.props;
---

<a 
  href={href} 
  class={`hover-scramble group relative inline-flex items-center justify-center border border-white/20 text-[11px] font-space-mono tracking-[0.15em] uppercase transition-colors duration-300 hover:border-accent-red hover:text-accent-red ${className ? className : 'px-7 py-3 font-bold'}`}
  data-text={text}
>
  <span class="scramble-text relative z-10 pointer-events-none">{text}</span>
</a>

<script>
  // @ts-nocheck
  const chars = '!<>-_\\/[]{}—=+*^?#________';
  
  class ScrambleText {
    constructor(el) {
      this.el = el;
      this.originalText = el.getAttribute('data-text') || '';
      
      this.el.addEventListener('mouseenter', () => this.scramble());
      this.el.addEventListener('mouseleave', () => this.resolve());
    }

    scramble() {
      clearInterval(this.interval);
      const length = this.originalText.length;
      let iterations = 0;
      
      this.interval = setInterval(() => {
        this.el.querySelector('.scramble-text').textContent = this.originalText
          .split('')
          .map((char, index) => {
            if (index < iterations) {
              return this.originalText[index];
            }
            return chars[Math.floor(Math.random() * chars.length)];
          })
          .join('');
        
        if (iterations >= length) {
          clearInterval(this.interval);
        }
        
        iterations += 1 / 3; // Adjust speed of resolution here
      }, 30);
    }

    resolve() {
      clearInterval(this.interval);
      this.el.querySelector('.scramble-text').textContent = this.originalText;
    }
  }

  // Initialize on all scramble elements
  document.querySelectorAll('.hover-scramble').forEach(btn => {
    new ScrambleText(btn);
  });
</script>
