---
import { Triangle, Diamond, Hexagon, Zap } from 'lucide-react';

const workflowSteps = [
  {
    icon: Triangle,
    title: "AI-Assisted Design",
    desc: "Rapid prototyping, intelligent layout suggestions, and AI-generated assets that we refine by hand."
  },
  {
    icon: Diamond,
    title: "Smart Development",
    desc: "AI pair-programming, automated testing, and code review that catches issues before they ship."
  },
  {
    icon: Hexagon,
    title: "Data-Driven Strategy",
    desc: "Market research, competitor analysis, and content strategy powered by AI — so decisions are backed by data, not guesses."
  },
  {
    icon: Zap,
    title: "Faster Delivery",
    desc: "What takes other agencies weeks, we deliver in days. AI handles the repetitive work so our team focuses on the creative."
  }
];
---

<section class="w-full bg-accent-red relative overflow-hidden py-24 md:py-32" id="ai-workflow">
  
  {/* Header Section */}
  <div class="flex flex-col items-center justify-center text-center mb-8 md:mb-12">
    <div class="workflow-reveal overflow-hidden leading-[0.9] pb-2">
      <h2 class="px-2 text-qwi-bg-main font-jetbrains-mono font-bold text-[10vw] md:text-[80px] leading-[0.9] tracking-tighter uppercase relative z-10 translate-y-[120%] inline-block">
        AI-POWERED
      </h2>
    </div>
    <div class="workflow-reveal overflow-hidden leading-[0.9] pb-2">
      <h2 class="px-2 text-transparent [-webkit-text-stroke:1.5px_#0a0a0a] font-jetbrains-mono font-bold text-[10vw] md:text-[80px] leading-[0.9] tracking-tighter uppercase relative z-10 translate-y-[120%] inline-block">
        WORKFLOW
      </h2>
    </div>
  </div>

  {/* Description */}
  <div class="workflow-reveal overflow-hidden max-w-2xl mx-auto text-center px-4 mb-16 md:mb-24">
    <p class="font-space-mono text-qwi-bg-main/80 text-[12px] md:text-[14px] leading-[1.8] translate-y-full inline-block">
      We don't just build AI solutions for clients — we use AI to supercharge how we work. Every project benefits from intelligent tools that accelerate delivery without sacrificing craft.
    </p>
  </div>

  {/* Grid Section */}
  <div class="w-[90%] max-w-[1100px] mx-auto px-4 md:px-0">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-[1px] md:gap-[2px]">
      {workflowSteps.map((step, index) => {
        const Icon = step.icon;
        return (
          <div class="workflow-card opacity-0 translate-y-24 p-6 md:px-10 md:py-8 bg-[#DF5425] hover:shadow-xl hover:brightness-95 transition-[box-shadow,filter] duration-300 group">
            <div class="text-[#0a0a0a] mb-6">
              <Icon size={24} strokeWidth={1.5} />
            </div>
            <h3 class="text-[#0a0a0a] font-jetbrains-mono font-bold text-[16px] md:text-[18px] mb-3 tracking-wide">
              {step.title}
            </h3>
            <p class="text-[#0a0a0a]/70 font-space-mono text-[12px] md:text-[13px] leading-[1.8]">
              {step.desc}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Reveal Header and Description
  const reveals = document.querySelectorAll('#ai-workflow .workflow-reveal > *');
  if (reveals.length > 0) {
    gsap.to(reveals, {
      scrollTrigger: {
        trigger: '#ai-workflow',
        start: 'top 80%',
      },
      y: 0,
      duration: 1.2,
      stagger: 0.15,
      ease: 'power4.out'
    });
  }

  // Fade Cards In
  const cards = document.querySelectorAll('#ai-workflow .workflow-card');
  if (cards.length > 0) {
    gsap.to(cards, {
      scrollTrigger: {
        trigger: '#ai-workflow .grid',
        start: 'top 75%',
      },
      opacity: 1,
      y: 0,
      duration: 1.2,
      stagger: 0.15,
      ease: 'power4.out'
    });
  }
</script>
