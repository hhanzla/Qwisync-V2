---
const steps = [
  {
    num: "01",
    title: "Discovery",
    desc: "We learn your business, audience, and goals. AI-assisted research gives us deep market insights from day one."
  },
  {
    num: "02",
    title: "Strategy",
    desc: "We define the roadmap — scope, timeline, tech stack, and deliverables. No surprises."
  },
  {
    num: "03",
    title: "Design & Build",
    desc: "Iterative design and development with continuous feedback loops. You see progress daily, not monthly."
  },
  {
    num: "04",
    title: "Launch & Grow",
    desc: "We deploy, monitor, and optimize. Post-launch support and growth strategy included."
  }
];
---

<section class="w-full bg-qwi-bg-main relative overflow-hidden py-24 md:py-32 border-t border-white/10" id="about-how-we-work">
  
  {/* Header Section */}
  <div class="flex flex-col items-center justify-center text-center mb-16 md:mb-24">
    <div class="about-work-reveal overflow-hidden leading-[0.9] pb-2">
      <h2 class="text-qwi-text-heading font-jetbrains-mono font-bold text-[10vw] md:text-[80px] leading-[0.9] tracking-tighter uppercase relative z-10 translate-y-[120%] inline-block">
        HOW WE
      </h2>
    </div>
    <div class="about-work-reveal overflow-hidden leading-[0.9] pb-2">
      <h2 class="text-transparent [-webkit-text-stroke:1px_var(--color-qwi-text-heading)] font-jetbrains-mono font-bold text-[10vw] md:text-[80px] leading-[0.9] tracking-tighter uppercase relative z-10 translate-y-[120%] inline-block">
        WORK
      </h2>
    </div>
  </div>

  {/* Grid Section */}
  <div class="w-[90%] max-w-[1400px] mx-auto px-4 md:px-0">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-0 border border-white/10">
      {steps.map((step, index) => (
        <div class={`about-work-card opacity-0 translate-y-12 p-8 md:p-10 border-white/10 ${index !== 3 ? 'border-b lg:border-b-0 lg:border-r' : ''} ${index === 1 ? 'md:border-b-0 md:border-r-0 lg:border-r' : ''} ${index === 0 ? 'md:border-r' : ''} ${index === 2 ? 'md:border-r' : ''} hover:bg-[#0d0d0d] transition-colors duration-300 group`}>
          <div class="text-accent-red font-jetbrains-mono font-bold text-[40px] md:text-[50px] leading-none mb-6 opacity-70 group-hover:opacity-100 transition-opacity duration-300">
            {step.num}
          </div>
          <h3 class="hover-scramble text-qwi-text-heading font-jetbrains-mono font-bold text-[18px] md:text-[20px] mb-4 tracking-wide" data-text={step.title}>
            <span class="scramble-text pointer-events-none">{step.title}</span>
          </h3>
          <p class="text-qwi-text-desc font-space-mono text-[12px] md:text-[13px] leading-[1.8] group-hover:text-gray-300 transition-colors duration-300">
            {step.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Reveal Header Texts
  const titleReveals = document.querySelectorAll('#about-how-we-work .about-work-reveal > h2');
  if (titleReveals.length > 0) {
    gsap.to(titleReveals, {
      scrollTrigger: {
        trigger: '#about-how-we-work',
        start: 'top 80%',
      },
      y: 0,
      duration: 1.2,
      stagger: 0.15,
      ease: 'power4.out'
    });
  }

  // Fade Up Step Cards
  const cards = document.querySelectorAll('#about-how-we-work .about-work-card');
  if (cards.length > 0) {
    gsap.to(cards, {
      scrollTrigger: {
        trigger: '#about-how-we-work .grid',
        start: 'top 85%',
      },
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: 'power3.out'
    });
  }
</script>
